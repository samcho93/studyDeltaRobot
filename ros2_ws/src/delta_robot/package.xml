<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>delta_robot</name>
  <version>0.1.0</version>
  <description>
    Rotary delta robot for the studyDeltaRobot course: mock/serial driver, Cartesian commander,
    WebSocket bridge to the web simulator, URDF display launch files. Robot math comes from the
    `deltarobot` Python library (pip install -e &lt;repo&gt;/python).
  </description>
  <maintainer email="samdori93@gmail.com">studyDeltaRobot</maintainer>
  <license>MIT</license>

  <exec_depend>rclpy</exec_depend>
  <exec_depend>sensor_msgs</exec_depend>
  <exec_depend>std_msgs</exec_depend>
  <exec_depend>std_srvs</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <exec_depend>robot_state_publisher</exec_depend>
  <exec_depend>rviz2</exec_depend>
  <exec_depend>launch</exec_depend>
  <exec_depend>launch_ros</exec_depend>
  <exec_depend>ament_index_python</exec_depend>
  <exec_depend>python3-serial</exec_depend>
  <!-- deltarobot and websockets>=12 come from pip (apt's python3-websockets is too old for the sync server):
       pip install -e "<repo>/python[websim,serial]" -->


  <test_depend>python3-pytest</test_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
